# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Backend ---
JWT_SECRET=change-me
JWT_TTL_MINUTES=30
# Local demo uses SQLite. docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./silentseal.db
CORS_ORIGINS=http://localhost:5173
MAX_FAILED_ATTEMPTS=5
LOCKOUT_SECONDS=60
# Requests allowed per client address per window, by route group. 0 turns a limit off.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=30
RATE_LIMIT_SHARE_LINK=120
RATE_LIMIT_DEMO=240
RATE_LIMIT_API=600
# mock  = record messages for the judge dashboard, send nothing (default)
# email = send real email over SMTP        sms = send real SMS through Twilio
# live  = both: each contact is reached by their own channel
NOTIFY_ADAPTER=mock
# twilio sends for real. A Twilio trial can only text numbers verified in its console.
SMS_PROVIDER=
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number messages are sent from, with country code.
TWILIO_FROM=
# For Gmail: host smtp.gmail.com, port 587, user your address, password an app password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Base of the live map link sent to contacts. Must be reachable from their phones.
PUBLIC_BASE_URL=http://localhost:8000
LIVE_SHARE_TTL_MINUTES=120
# Enables the judge dashboard at /api/demo/dashboard and the demo tools, and makes the app
# label simulated parts and offer sample data. Empty disables all of it (404).
# Never set this on a server holding real data: the dashboard shows alerts from every account.
DEMO_DASHBOARD_TOKEN=

# --- Postgres (docker-compose) ---
POSTGRES_USER=seal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=silentseal

# --- Frontend (exposed to the browser bundle; NOT secret) ---
# The starting sequence: typed on the calculator, followed by "=", it opens first-time setup
# on a phone with no account. During setup each survivor chooses a private sequence of their own.
VITE_UNLOCK_SEQUENCE=1379
