# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Backend ---
JWT_SECRET=change-me
JWT_TTL_MINUTES=30
# Local demo uses SQLite. docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./silentseal.db
CORS_ORIGINS=http://localhost:5173
MAX_FAILED_ATTEMPTS=5
LOCKOUT_SECONDS=60
# mock | sms | email. sms and email are stubs: they check config but send nothing.
NOTIFY_ADAPTER=mock
SMS_PROVIDER=
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Enables the received-alerts demo dashboard at /api/demo/dashboard. Empty disables it.
DEMO_DASHBOARD_TOKEN=

# --- Postgres (docker-compose) ---
POSTGRES_USER=seal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=silentseal

# --- Frontend (exposed to the browser bundle; NOT secret) ---
# Typed on the calculator, followed by "=", opens the hidden unlock mode.
VITE_UNLOCK_SEQUENCE=1379
